OPENAI_API_KEY=
NASA_API_KEY=
LIVIA_REGION=dev
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=
ACCEPTED_PASSPHRASES=

# Optional Apple WeatherKit astronomy fields used by the Aurora query.
WEATHERKIT_KEY_ID=
WEATHERKIT_TEAM_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_PRIVATE_KEY=

# Aurora prediction service override.
AURORA_ML_API_URL=https://aurora.arryan.xyz

# Internal APOD service. It currently has no authentication.
APOD_SERVICE_BASE_URL=https://apod.api.cosmofy.services.deployim.com
APOD_CONNECT_TIMEOUT=3s
APOD_REQUEST_TIMEOUT=35s
APOD_SEARCH_REQUEST_TIMEOUT=15s
APOD_MAX_ATTEMPTS=2
APOD_RETRY_BACKOFF=200ms

# Internal News service. It currently has no authentication.
NEWS_SERVICE_BASE_URL=https://news.api.cosmofy.services.deployim.com
NEWS_CONNECT_TIMEOUT=3s
NEWS_REQUEST_TIMEOUT=15s
NEWS_MAX_ATTEMPTS=2
NEWS_RETRY_BACKOFF=200ms

# Internal Articles service. It currently has no authentication.
ARTICLES_SERVICE_URL=https://articles.api.cosmofy.services.deployim.com
ARTICLES_CONNECT_TIMEOUT=3s
ARTICLES_REQUEST_TIMEOUT=15s
ARTICLES_MAX_ATTEMPTS=2
ARTICLES_RETRY_BACKOFF=200ms

# Supply these to the OpenTelemetry Java agent in production. The endpoint must be private.
OTEL_SERVICE_NAME=livia
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_PROPAGATORS=tracecontext,baggage
